# Public address without a protocol or path.
SITE_DOMAIN=repethelper.your-domain.ru

# GitHub Container Registry tag. Production deployments should use sha-<commit>.
IMAGE_TAG=sha-0000000

POSTGRES_DB=repethelper
POSTGRES_USER=repethelper
POSTGRES_PASSWORD=replace-with-at-least-16-random-characters

TEACHER_USERNAME=teacher
TEACHER_PASSWORD=replace-with-at-least-16-random-characters
TEACHER_NAME=Преподаватель
TEACHER_CODE=replace-private-code

# Yandex 360 domain mailbox. Never commit the real password.
MAIL_HOST=smtp.yandex.ru
MAIL_PORT=465
MAIL_USERNAME=no-reply@repethelper.ru
MAIL_PASSWORD=replace-with-yandex-app-password
MAIL_FROM=no-reply@repethelper.ru
MAIL_REPLY_TO=efimok05@gmail.com

# VK ID OAuth. Keep the secret only in the server .env.
APP_VK_AUTH_ENABLED=false
VK_CLIENT_ID=replace-with-vk-app-id
VK_CLIENT_SECRET=replace-with-vk-client-secret
VK_REDIRECT_URI=https://repethelper.ru/login/oauth2/code/vk

# Public legal details. Do not add a home street address.
APP_LEGAL_OPERATOR_NAME=Ефимов Ефим Александрович
APP_LEGAL_STATUS=самозанятый
APP_LEGAL_INN=701774242586
APP_LEGAL_CITY=Краснодар
APP_LEGAL_EMAIL=efimok05@gmail.com

# Encrypted off-server backups in Yandex Object Storage.
RESTIC_REPOSITORY=s3:https://storage.yandexcloud.net/replace-with-bucket-name
RESTIC_PASSWORD=replace-with-at-least-24-random-characters
AWS_ACCESS_KEY_ID=replace-with-yandex-static-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-yandex-static-secret-access-key
AWS_DEFAULT_REGION=ru-central1
# Enable after the subscription migration and smoke test
APP_SUBSCRIPTIONS_ENABLED=false

# Private control console. Generate three different values with `openssl rand -base64 32`.
# Keep APP_ADMIN_ENABLED=false until Tailscale Serve is configured on the VPS.
APP_ADMIN_ENABLED=false
APP_ADMIN_GATEWAY_SECRET=replace-with-at-least-32-random-characters
APP_ADMIN_TOTP_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
APP_ADMIN_BOOTSTRAP_TOKEN=replace-with-at-least-32-random-characters

# Optional privacy-preserving product metrics. Uses a rotating daily HMAC, not raw IP storage.
APP_METRICS_ENABLED=false
APP_METRICS_HMAC_KEY=replace-with-at-least-32-random-characters
