{$SITE_DOMAIN} {
	encode zstd gzip

	@internal path /actuator /actuator/*
	respond @internal 404
	@privateControl path /admin /admin/* /control /control/* /internal-control /internal-control/*
	respond @privateControl 404

	request_body {
		max_size 80MB
	}

	reverse_proxy app:8080

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		-Server
	}

	log {
		output discard
	}
}

# Listens only on the host loopback address (published by Compose). Tailscale Serve
# forwards here; this route is deliberately separate from the public site.
:8081 {
	@control path /control /control/*
	handle @control {
		request_header X-RepetHelper-Admin-Gateway "{$ADMIN_GATEWAY_SECRET}"
		reverse_proxy app:8080
	}
	respond 404
}
