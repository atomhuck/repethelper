{$SITE_DOMAIN} {
	encode zstd gzip

	@internal path /actuator /actuator/*
	respond @internal 404
	@privateControl path /admin /admin/* /control /control/* /internal-control /internal-control/*
	respond @privateControl 404

	request_body {
		max_size 80MB
	}

	reverse_proxy app:8080

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		-Server
	}

	log {
		output discard
	}
}

# Listens only on the host loopback address (published by Compose). Tailscale Serve
# forwards here; this route is deliberately separate from the public site.
:8081 {
	# Control pages reuse local versioned styles, scripts and brand assets. These
	# files remain reachable only through the tailnet listener.
	@assets path /css/* /js/* /brand/* /favicon.ico /webjars/*
	handle @assets {
		reverse_proxy app:8080
	}

	@control path /control /control/*
	handle @control {
		request_header X-RepetHelper-Admin-Gateway "{$ADMIN_GATEWAY_SECRET}"
		reverse_proxy app:8080 {
			# Tailscale terminates TLS before this loopback hop. Preserve the
			# original secure request context for redirects and session handling.
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {http.request.host}
			header_up X-Forwarded-Port 443
		}
	}
	respond 404
}
